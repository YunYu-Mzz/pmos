# Collector worker for one province (%i). Attaches to pmos-browser@%i over
# loopback CDP. Restart=no: a fault holds for human review instead of looping.
[Unit]
Description=PMOS collector (%i)
After=pmos-browser@%i.service

[Service]
# Offline release: no service/browser launch until a separately reviewed release.
ExecStartPre=/usr/bin/false
User=pmos
WorkingDirectory=/home/pmos/pmos
Environment=PMOS_DATA=/home/pmos/pmos-data
ExecStart=/home/pmos/pmos/.venv/bin/python -m pmos %i run
Restart=no
KillSignal=SIGTERM
# Only the worker: it finishes the request in flight. The whole cgroup would kill its Playwright driver too, and the answer
# would be lost (Liaoning 2026-11-01 16:21: a 0.4 s query waited out 45 s as network_error and blocked the province).
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
